# ClipCraft AI - Default Environment Settings
APP_ENV=production
APP_PORT=8080
DATABASE_PATH=data/app.db
STORAGE_PATH=storage/jobs

# Resource Constraints (Optimized for 4 Cores, 8 GB RAM, 32 GB Disk)
MAX_CONCURRENT_JOBS=1
MAX_SOURCE_VIDEO_MB=2048
MAX_SOURCE_DURATION_MINUTES=120
MAX_TEMP_STORAGE_GB=20
MIN_FREE_DISK_GB=8

# AI Models (Configurable)
WHISPER_MODEL=base
YOLO_MODEL=yolov8n.pt
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Social Media Publishing (Optional)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Cleanup TTL
JOB_TTL_HOURS=12
