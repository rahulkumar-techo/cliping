# ==================================================
# ClipCraft AI - Environment Configuration
# ==================================================

# Server Environment & Port
APP_ENV=production
APP_PORT=8080

# File Paths
DATABASE_PATH=data/app.db
STORAGE_PATH=storage/jobs
PYTHON_PATH=python3
WORKER_SCRIPT=apps/worker/src/main.py

# Resource Limits (Target: 4 CPU Cores, 8 GB RAM, 32 GB Disk)
MAX_CONCURRENT_JOBS=1
MAX_SOURCE_VIDEO_MB=2048
MAX_SOURCE_DURATION_MINUTES=120
MAX_TEMP_STORAGE_GB=20
MIN_FREE_DISK_GB=8

# AI Models (Configurable, Never Hard-Coded)
WHISPER_MODEL=base
YOLO_MODEL=yolov8n.pt
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# YouTube Data API Publishing (Optional)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Meta Graph API for Instagram Reels (Optional)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Cleanup TTL (Hours before abandoned/temporary jobs are purged)
JOB_TTL_HOURS=12
